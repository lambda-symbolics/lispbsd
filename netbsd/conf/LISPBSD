# LispBSD amd64 kernel.
#
# GENERIC plus Multiboot, so QEMU -kernel can load this image without
# the stock bootloader. Serial console is selected at boot with
# console=com on the Multiboot command line.
#
# CONSDEVNAME/CONS_OVERRIDE are omitted: they break xen pvh_consinit.c
# in GENERIC.

include 	"arch/amd64/conf/GENERIC"

ident 		LISPBSD

options 	MULTIBOOT

# Host-exported filesystems for development (Autolith, lispbsd source).
# PUFFS/putter already come from GENERIC's filesystems.config.
vio9p*	at virtio?
