#!/bin/sh
# Boot a disk image under QEMU, headless, with the guest serial console
# multiplexed onto stdin/stdout.
#
# Usage: script/vm-run image [qemu arguments...]
#
# Extra arguments are appended verbatim. Set KERNEL to a NetBSD kernel
# path to load it with Multiboot instead of the image bootloader.
# KERNEL_APPEND defaults to a serial console and wd0a root.
set -eu

IMAGE=${1:?usage: script/vm-run image [qemu arguments...]}
shift

KERNEL=${KERNEL:-}
KERNEL_APPEND=${KERNEL_APPEND:-console=com root=wd0a}

if [ -n "$KERNEL" ]; then
    exec qemu-system-x86_64 \
        -enable-kvm \
        -m 1024 \
        -drive "file=$IMAGE,format=raw" \
        -nographic \
        -no-reboot \
        -kernel "$KERNEL" \
        -append "$KERNEL_APPEND" \
        "$@"
fi

exec qemu-system-x86_64 \
    -enable-kvm \
    -m 1024 \
    -drive "file=$IMAGE,format=raw" \
    -nographic \
    -no-reboot \
    "$@"
